# Ignore Results folders
Results/
Results_3DPLS/
Codes/Matrix/

# Ignore any __pycache__ directories (Python bytecode cache files)
**/__pycache__/
**/*.py[cod]

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
MANIFEST

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.cache
.pytest_cache/
.coverage.*
*.cover
*.py,cover

# Environments
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# mypy
.mypy_cache/

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# Custom files to ignore in your project
input/*.dat
*.dat
*.1
*.save
*.json
*_cache/*
*.ipynb_checkpoints*/
run/*
